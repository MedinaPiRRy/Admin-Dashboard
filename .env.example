# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Include a database name between the host and the "?", e.g. .../admin-dashboard?retryWrites=true
DB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/admin-dashboard?retryWrites=true&w=majority"

# Secret used by NextAuth to sign sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Local development only (do not set this on Vercel):
# AUTH_URL="http://localhost:3000/api/auth"
